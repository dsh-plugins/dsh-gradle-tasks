{
  "name": "@dsh-plugin/dsh-gradle-tasks",
  "version": "0.1.0",
  "type": "module",
  "description": "Gradle task browser for the DSH right Sidebar: detects the Session's Gradle project, lists every task grouped by its declared group, runs a task from its project wrapper with a chosen JDK, and streams the build output back into the panel.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown --config tsdown.client.config.mjs && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "prepack": "npm run build"
  },
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-gradle-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-gradle-tasks/issues"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-gradle-tasks#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "gradle",
    "tasks",
    "java"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
